+        spaced = _re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", text)
+        # Replace common separators with spaces.
+        spaced = _re.sub(r"[-_.]+", " ", spaced)
+        return " ".join(spaced.lower().split())
